# ==============================================================================
# STUDIO DESIRE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and customize for your deployment environment:
#   Local Development:  copy .env.example .env (or run setup.bat)
#   Production Hosting: cp .env.example .env
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit your actual .env file or production credentials to Git.
# 2. In production, ALWAYS set APP_ENV=production and APP_DEBUG=false.
# 3. Generate your unique APP_KEY via: php artisan key:generate
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="Studio Desire"

# Production: set to 'production'
# Local development: set to 'local'
APP_ENV=production

# Application Key: Generate with 'php artisan key:generate'
APP_KEY=

# In production, ALWAYS set APP_DEBUG=false. Exposing debug mode leaks stack traces,
# environment variables, and database credentials to visitors.
APP_DEBUG=false

APP_TIMEZONE="Asia/Kolkata"

# Canonical public website URL (Must use https:// on live hosting without trailing slash)
# Local: http://127.0.0.1:8080
# Production: https://your-domain.com
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# 2. LOGGING CONFIGURATION
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Use 'error' or 'warning' in production; 'debug' in local development
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Choose one of the following database options:
#
# ------------------------------------------------------------------------------
# OPTION A: SUPABASE POSTGRESQL (Recommended for Cloud / Scalable Deployments)
# ------------------------------------------------------------------------------
# Supabase provides PostgreSQL with SSL encryption.
# You can connect using either individual parameters or DATABASE_URL:
#
# 1. Connection Pooler (Port 6543 / Session Mode - Recommended for PHP / Hostinger):
# DB_CONNECTION=pgsql
# DB_HOST=aws-0-[region].pooler.supabase.com
# DB_PORT=6543
# DB_DATABASE=postgres
# DB_USERNAME=postgres.[your-project-ref]
# DB_PASSWORD="your-supabase-db-password"
# DB_SSLMODE=require
# DB_SCHEMA=public
#
# 2. Schema Isolation (Optional, to keep Laravel tables hidden from Supabase REST API):
# DB_SCHEMA=studio_desire
#
# 3. Or using single DATABASE_URL connection string:
# DATABASE_URL="postgresql://postgres.[your-project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require"
#
# ------------------------------------------------------------------------------
# OPTION B: LOCAL SQLITE DEVELOPMENT (Fastest zero-configuration local dev)
# ------------------------------------------------------------------------------
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
#
# ------------------------------------------------------------------------------
# OPTION C: HOSTINGER / CPANEL MYSQL (Standard Shared Hosting)
# ------------------------------------------------------------------------------
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=your_hostinger_database_name
# DB_USERNAME=your_hostinger_database_user
# DB_PASSWORD=your_hostinger_database_password

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION, SESSIONS & COOKIES
# ------------------------------------------------------------------------------
# Studio Desire uses dual-layer authentication:
#  - Owner Web Panel: Cookie-based session / Sanctum SPA stateful auth
#  - API Clients / React: Sanctum Bearer tokens (with optional cookie support)
#
# Session driver: 'database' or 'file' (both work on standard shared hosting)
SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/

# Session Domain:
# Leave as null when running on a single domain (e.g. your-domain.com).
# If sharing session across subdomains (e.g. api.your-domain.com and your-domain.com),
# set to '.your-domain.com'.
SESSION_DOMAIN=null

# In production over HTTPS, ALWAYS set SESSION_SECURE_COOKIE=true.
# For local HTTP testing (http://127.0.0.1:8080), leave false.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ------------------------------------------------------------------------------
# 5. SANCTUM & CORS CONFIGURATION
# ------------------------------------------------------------------------------
# Comma-separated list of stateful domains for cookie-based Sanctum authentication.
# In production, specify your root domain and www subdomain (without https:// and without port).
# Local: "localhost,localhost:8080,127.0.0.1,127.0.0.1:8080"
# Production: "your-domain.com,www.your-domain.com"
SANCTUM_STATEFUL_DOMAINS="your-domain.com,www.your-domain.com"

# Comma-separated allowed origins for browser CORS headers.
# Local: "http://127.0.0.1:8080,http://localhost:8080"
# Production: "https://your-domain.com,https://www.your-domain.com"
CORS_ALLOWED_ORIGINS="https://your-domain.com,https://www.your-domain.com"

# ------------------------------------------------------------------------------
# 6. STORAGE & FILE SYSTEM
# ------------------------------------------------------------------------------
# Default filesystem disk
FILESYSTEM_DISK=public

# Media disk for portfolio project images & public assets ('public' or 'supabase')
MEDIA_DISK=public

# Attachments disk for confidential enquiry uploads ('local' or 'supabase_private')
# Keeping enquiry attachments on 'local' ensures they are strictly private and not exposed on public URLs.
ATTACHMENTS_DISK=local

# When using MEDIA_DISK=supabase or FILESYSTEM_DISK=supabase:
# Note: Requires 'composer require league/flysystem-aws-s3-v3'
# SUPABASE_STORAGE_KEY=your_supabase_s3_access_key
# SUPABASE_STORAGE_SECRET=your_supabase_s3_secret_key
# SUPABASE_STORAGE_REGION=us-east-1
# SUPABASE_STORAGE_BUCKET=studio-desire-public
# SUPABASE_STORAGE_ENDPOINT=https://[your-project-ref].supabase.co/storage/v1/s3
# SUPABASE_STORAGE_URL=https://[your-project-ref].supabase.co/storage/v1/object/public/studio-desire-public

# Max upload limit in bytes (50MB = 52428800)
MAX_UPLOAD_SIZE_BYTES=52428800

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=sync
CACHE_STORE=file

# ------------------------------------------------------------------------------
# 7. NOTIFICATIONS & EMAIL (HOSTINGER WEBMAIL / SMTP)
# ------------------------------------------------------------------------------
# Target email receiving new project enquiries:
ENQUIRY_NOTIFICATION_EMAIL="owner@your-domain.com"

# Hostinger SMTP Settings:
# Hostinger SMTP Host: smtp.hostinger.com
# Port: 465 (with SSL) or 587 (with TLS)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=inquiries@your-domain.com
MAIL_PASSWORD=your_hostinger_email_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="inquiries@your-domain.com"
MAIL_FROM_NAME="Studio Desire Architecture"

# ------------------------------------------------------------------------------
# 8. SAFE INITIAL ADMIN BOOTSTRAP
# ------------------------------------------------------------------------------
# Used ONLY by 'php artisan db:seed' on a brand-new empty database.
INITIAL_ADMIN_NAME="Studio Desire Owner"
INITIAL_ADMIN_EMAIL="owner@your-domain.com"
INITIAL_ADMIN_PASSWORD="REPLACE_WITH_VERY_STRONG_SECRET_PASSWORD"

# ------------------------------------------------------------------------------
# 9. FRONTEND INTEGRATION
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
# When frontend is served directly by Laravel's public directory (production default),
# leave VITE_API_URL empty so requests route to same-origin /api.
VITE_API_URL=""
