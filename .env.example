APP_NAME="Studio Desire"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="Asia/Kolkata"
APP_URL=http://127.0.0.1:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (MySQL recommended for production hosting, SQLite available for local testing)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=studio_desire
DB_USERNAME=root
DB_PASSWORD=

# Session & Storage
SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file

# Studio Desire Application Configuration
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080,https://studiodesire.com"
MAX_UPLOAD_SIZE_BYTES=52428800
ENQUIRY_NOTIFICATION_EMAIL="owner@studiodesire.com"

# Safe Initial Admin Bootstrap (Used only by initial seeder on empty database)
INITIAL_ADMIN_NAME="Studio Desire Admin"
INITIAL_ADMIN_EMAIL="admin@studiodesire.com"
INITIAL_ADMIN_PASSWORD="ReplaceWithStrongAdminPassword123!"

# Mail Settings (Used for Inquiry Alerts & Password Reset)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="inquiries@studiodesire.com"
MAIL_FROM_NAME="Studio Desire Inquiries"

VITE_APP_NAME="${APP_NAME}"
VITE_API_URL=""
